# ============================================================
# Environment Configuration Template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_ENV=development
APP_NAME="Adaptive Learning Platform"
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# ─── Database (PostgreSQL) ──────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adaptive_learning
POSTGRES_USER=alp_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DATABASE_URL=postgresql://alp_user:CHANGE_ME_strong_password@localhost:5432/adaptive_learning

# ─── JWT Auth ───────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM Provider ──────────────────────────────────────────
# Primary: google (gemini), Options: openai, google, local
LLM_PROVIDER=google
GOOGLE_API_KEY=CHANGE_ME_your_google_api_key
GOOGLE_MODEL=gemini-1.5-flash

# Optional OpenAI (fallback or comparison)
OPENAI_API_KEY=CHANGE_ME_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Local LLM (Ollama fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LLM safety settings
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=30

# ─── RAG & Vector Store ─────────────────────────────────────
VECTOR_STORE=chromadb
CHROMA_PERSIST_DIR=./rag/chroma_db
CHROMA_COLLECTION_PREFIX=alp

# Embedding model (leave empty to use LLM provider's embedding)
EMBEDDING_MODEL=models/embedding-001
EMBEDDING_PROVIDER=google

# ─── ML Pipeline ────────────────────────────────────────────
MODEL_STORE_DIR=./models
RANDOM_SEED=42
ML_TRAIN_TEST_SPLIT=0.2
ML_VALIDATION_SPLIT=0.1

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
LLM_RATE_LIMIT_PER_MINUTE=10

# ─── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Frontend ───────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Adaptive Learning Platform"
