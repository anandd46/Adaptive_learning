# =============================================================
# Adaptive Learning Platform — .gitignore
# =============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.whl
*.pyc
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Environment / Secrets — NEVER commit
.env
.env.local
.env.development
.env.production
*.env
secrets/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ML Models (large binary files — use Git LFS or model registry)
models/**/*.pkl
models/**/*.joblib
models/**/*.h5
models/**/*.pt
models/**/*.pth
models/**/*.onnx
# Keep metadata JSON
!models/**/*.json
!models/**/*.yaml

# Data files (use DVC or document separately)
data/raw/**
data/processed/**
# Keep synthetic demo data
!data/synthetic/**
!data/**/.gitkeep

# Vector store database
rag/chroma_db/
*.chroma
chroma.sqlite3

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/build/
frontend/.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
*.orig
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.coveragerc
.mypy_cache/
.ruff_cache/

# Docker
*.pid

# Reports / generated outputs
reports/figures/*.png
reports/figures/*.svg
reports/figures/*.pdf
# Keep report markdown
!reports/**/*.md

# OS
__MACOSX/
